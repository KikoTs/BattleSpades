[Unit]
Description=BattleSpades retail Steam advertisement
Wants=network-online.target
Requires=battlespades-retail-port.service
After=network-online.target battlespades-retail-port.service battlespades@tdm.service
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=battlespades-steam
Group=battlespades-steam
StateDirectory=battlespades-steam
StateDirectoryMode=0700
WorkingDirectory=/var/lib/battlespades-steam
Environment=HOME=/var/lib/battlespades-steam
Environment=LD_LIBRARY_PATH=/opt/battlespades-steam/runtime
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 -u /opt/battlespades-steam/steam_linux_sidecar.py --runtime /opt/battlespades-steam/runtime --source-port 27015 --mode tdm --region europe
Restart=on-failure
RestartSec=30
TimeoutStopSec=15
KillMode=control-group
UMask=0077
MemoryMax=512M
TasksMax=128
LimitNOFILE=4096
LimitCORE=0
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK

[Install]
WantedBy=multi-user.target
